pipeline {
    agent any
    
    environment {
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-creds')
        DOCKERHUB_USERNAME = 'mostakimidlc'
        IMAGE_NAME = 'glpi'
        IMAGE_TAG = "prod-${env.BUILD_NUMBER}"
        LATEST_TAG = 'latest'
        FULL_IMAGE_NAME = "${DOCKERHUB_USERNAME}/${IMAGE_NAME}"
        GIT_BRANCH = 'production'
        COMPOSE_FILE = 'docker-compose.prod.yml'
    }
    
    stages {
        stage('🧹 Cleanup Workspace') {
            steps {
                echo '========== Cleaning Jenkins workspace =========='
                deleteDir()
                echo '✅ Workspace cleaned'
            }
        }
        
        stage('📥 Checkout Production Branch') {
            steps {
                echo '========== Checking out PRODUCTION branch (shallow clone) =========='
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "*/${GIT_BRANCH}"]],
                    doGenerateSubmoduleConfigurations: false,
                    extensions: [
                        [
                            $class: 'CloneOption',
                            depth: 1,
                            noTags: true,
                            shallow: true,
                            timeout: 30
                        ]
                    ],
                    userRemoteConfigs: [[
                        credentialsId: 'github-creds',
                        url: 'https://github.com/mostakimidlc-prog/glpi.git'
                    ]]
                ])
                
                sh '''
                    echo "Current branch:"
                    git branch --show-current || echo "Detached HEAD state"
                    echo "Latest commit:"
                    git log -1 --oneline
                '''
                echo "✅ Checked out branch: ${GIT_BRANCH}"
            }
        }
        
        stage('🔍 Verify Files') {
            steps {
                echo '========== Verifying required files =========='
                sh '''
                    if [ ! -f Dockerfile ]; then
                        echo "❌ ERROR: Dockerfile not found!"
                        exit 1
                    fi
                    echo "✅ Dockerfile found"
                    
                    if [ ! -f docker-compose.prod.yml ]; then
                        echo "❌ ERROR: docker-compose.prod.yml not found!"
                        exit 1
                    fi
                    echo "✅ docker-compose.prod.yml found"
                    
                    if [ ! -f docker-entrypoint.sh ]; then
                        echo "❌ ERROR: docker-entrypoint.sh not found!"
                        exit 1
                    fi
                    echo "✅ docker-entrypoint.sh found"
                '''
            }
        }
        
        stage('🏗️ Build Docker Image') {
            steps {
                echo '========== Building Production Docker Image =========='
                sh """
                    echo "Building: ${FULL_IMAGE_NAME}:${IMAGE_TAG}"
                    docker build -t ${FULL_IMAGE_NAME}:${IMAGE_TAG} .
                    
                    echo "Tagging as latest..."
                    docker tag ${FULL_IMAGE_NAME}:${IMAGE_TAG} ${FULL_IMAGE_NAME}:${LATEST_TAG}
                    
                    echo "✅ Images built!"
                """
            }
        }
        
        stage('🧪 Test Image') {
            steps {
                echo '========== Testing Docker Image =========='
                sh """
                    docker inspect ${FULL_IMAGE_NAME}:${IMAGE_TAG} > /dev/null 2>&1
                    echo "✅ Image verification passed!"
                """
            }
        }
        
        stage('🔐 Login to DockerHub') {
            steps {
                echo '========== Logging into DockerHub =========='
                sh '''
                    echo $DOCKERHUB_CREDENTIALS_PSW | docker login -u $DOCKERHUB_USERNAME --password-stdin
                    echo "✅ DockerHub login successful!"
                '''
            }
        }
        
        stage('📤 Push to DockerHub') {
            steps {
                echo '========== Pushing to DockerHub =========='
                sh """
                    docker push ${FULL_IMAGE_NAME}:${IMAGE_TAG}
                    docker push ${FULL_IMAGE_NAME}:${LATEST_TAG}
                    echo "✅ Images pushed!"
                """
            }
        }
        
        stage('🛑 Stop Old Production') {
            steps {
                echo '========== Stopping old production =========='
                sh """
                    docker-compose -f ${COMPOSE_FILE} down || true
                    echo "✅ Old production stopped"
                """
            }
        }
        
        stage('🚀 Deploy Production') {
            steps {
                echo '========== Deploying Production =========='
                sh """
                    export IMAGE_TAG=${IMAGE_TAG}
                    docker-compose -f ${COMPOSE_FILE} up -d --build
                    sleep 10
                    docker-compose -f ${COMPOSE_FILE} ps
                    echo "✅ Production deployed!"
                """
            }
        }
        
        stage('✅ Verify Deployment') {
            steps {
                echo '========== Verifying Deployment =========='
                sh """
                    if docker ps | grep -q "glpi-prod-app"; then
                        echo "✅ glpi-prod-app is running"
                    else
                        echo "❌ glpi-prod-app is NOT running"
                        exit 1
                    fi
                    
                    if docker ps | grep -q "glpi-prod-db"; then
                        echo "✅ glpi-prod-db is running"
                    else
                        echo "❌ glpi-prod-db is NOT running"
                        exit 1
                    fi
                    
                    sleep 5
                    if curl -f -s http://localhost:8090 > /dev/null; then
                        echo "✅ GLPI accessible at http://localhost:8090"
                    else
                        echo "⚠️ GLPI still starting..."
                    fi
                """
            }
        }
    }
    
    post {
        success {
            echo '========================================='
            echo '✅ PRODUCTION PIPELINE SUCCESS!'
            echo '========================================='
            echo "Image: ${FULL_IMAGE_NAME}:${IMAGE_TAG}"
            echo "Image: ${FULL_IMAGE_NAME}:${LATEST_TAG}"
            echo "DockerHub: https://hub.docker.com/r/${DOCKERHUB_USERNAME}/${IMAGE_NAME}"
            echo "Production: http://localhost:8090"
        }
        
        failure {
            echo '========================================='
            echo '❌ PIPELINE FAILED!'
            echo '========================================='
        }
        
        always {
            script {
                sh '''
                    docker logout || true
                    echo "=== Container Status ==="
                    docker ps --filter "name=glpi" --format "table {{.Names}}\\t{{.Status}}\\t{{.Ports}}" || true
                ''' 
            }
        }
    }
}
